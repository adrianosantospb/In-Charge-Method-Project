<script>
const DATA = __DATA__;
const SERIES = [
  { key: "review", label: "Review findings", color: "var(--series-1)" },
  { key: "readback", label: "Read-back failures", color: "var(--series-2)" },
  { key: "manual", label: "Manual test findings", color: "var(--series-3)" },
  { key: "production", label: "Errors in production", color: "var(--series-4)" },
];
const caught = (r) => ({
  review: r.review_high + r.review_medium + r.review_low,
  readback: r.readback_failures,
  manual: r.manual_findings,
  production: r.production_errors,
});
const sum = (rows, f) => rows.reduce((t, r) => t + f(r), 0);
// Budget values may be unknown (null): sum only the known ones and say how many are missing.
const known = (rows, key) => rows.filter((r) => r[key] !== null && r[key] !== undefined);
const budget = (rows, key, digits) => {
  const k = known(rows, key);
  if (!k.length) return "unknown";
  const total = sum(k, (r) => r[key]);
  const text = digits === undefined ? total.toLocaleString("en-US") : total.toFixed(digits);
  return k.length < rows.length ? `${text} (${rows.length - k.length} unknown)` : text;
};
const cell = (v, digits) => (v === null || v === undefined ? "—" : digits === undefined ? v.toLocaleString("en-US") : v.toFixed(digits));
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
// Every project with a file is an entry, even before its first activity.
const projects = __PROJECTS__;
const select = document.getElementById("project");
select.innerHTML = `<option value="">All projects (${projects.length})</option>` +
  projects.map((p) => `<option value="${esc(p)}">${esc(p)}</option>`).join("");
try { const saved = localStorage.getItem("metrics-project"); if (saved && projects.includes(saved)) select.value = saved; } catch {}

document.getElementById("legend").innerHTML =
  SERIES.map((s) => `<span><i style="background:${s.color}"></i>${s.label}</span>`).join("");

const tip = document.getElementById("tip");
function showTip(event, text) {
  tip.textContent = text; tip.style.display = "block";
  const x = Math.min(event.clientX + 12, innerWidth - tip.offsetWidth - 8);
  tip.style.left = x + "px"; tip.style.top = (event.clientY + 14) + "px";
}

function render() {
  const project = select.value;
  try { localStorage.setItem("metrics-project", project); } catch {}
  document.getElementById("print").textContent = project ? `Print ${project}` : "Print all projects";
  document.getElementById("print-title").textContent = `Project: ${project || "all projects"}. Generated __GENERATED__.`;
  const rows = DATA.filter((r) => !project || r.project === project);
  const before = sum(rows, (r) => { const c = caught(r); return c.review + c.readback + c.manual; });
  const prod = sum(rows, (r) => r.production_errors);
  const tiles = [
    [rows.length, "Activities", project ? project : `${projects.length} project(s)`],
    [before, "Errors caught before production", `${sum(rows, (r) => caught(r).review)} in reviews, ${sum(rows, (r) => r.readback_failures)} in read-backs, ${sum(rows, (r) => r.manual_findings)} in manual tests`],
    [prod, "Errors that reached production", prod ? "Each one deserves a lesson in memory" : "None recorded"],
    [sum(rows, (r) => r.questions), "Questions before starting", `${sum(rows, (r) => r.plan_changes)} changed the plan`],
    [budget(rows, "cost_usd", 2) === "unknown" ? "—" : "$" + budget(rows, "cost_usd", 2), "Cost (USD)", `${budget(rows, "duration_hours", 1)} hours, ${budget(rows, "tokens")} tokens`],
  ];
  document.getElementById("tiles").innerHTML = tiles.map(([v, l, d]) =>
    `<div class="tile"><div class="value">${v}</div><div class="label">${l}</div><div class="detail">${esc(d)}</div></div>`).join("");

  // One bar per project, or per activity when a project is selected.
  const groups = project
    ? rows.map((r) => ({ name: `${r.activity} ${r.name}`, values: caught(r) }))
    : projects.map((p) => {
        const pr = DATA.filter((r) => r.project === p);
        return { name: p, count: pr.length, values: Object.fromEntries(SERIES.map((s) => [s.key, sum(pr, (r) => caught(r)[s.key])])) };
      });
  const max = Math.max(1, ...groups.map((g) => SERIES.reduce((t, s) => t + g.values[s.key], 0)));
  const bars = document.getElementById("bars");
  bars.innerHTML = groups.length ? groups.map((g) => {
    const total = SERIES.reduce((t, s) => t + g.values[s.key], 0);
    const segs = SERIES.filter((s) => g.values[s.key] > 0).map((s) =>
      `<div class="seg" tabindex="0" style="flex:0 0 ${(g.values[s.key] / max) * 100}%;background:${s.color}" data-tip="${esc(g.name)}: ${g.values[s.key]} ${s.label.toLowerCase()}" aria-label="${esc(g.name)}: ${g.values[s.key]} ${s.label.toLowerCase()}"></div>`).join("");
    return `<div class="bar-row"><span class="name" title="${esc(g.name)}">${esc(g.name)}</span><div class="track">${segs || `<span class="empty">${g.count === 0 ? "No activities yet" : "No errors recorded"}</span>`}</div><span class="total">${total}</span></div>`;
  }).join("") : '<p class="empty">No activities recorded yet. Add a row to metrics/&lt;project&gt;.csv and run bin/metrics.</p>';
  for (const seg of bars.querySelectorAll(".seg")) {
    seg.addEventListener("mousemove", (e) => showTip(e, seg.dataset.tip));
    seg.addEventListener("mouseleave", () => (tip.style.display = "none"));
    seg.addEventListener("focus", () => { const r = seg.getBoundingClientRect(); showTip({ clientX: r.left, clientY: r.bottom }, seg.dataset.tip); });
    seg.addEventListener("blur", () => (tip.style.display = "none"));
  }

  const pRows = (project ? [project] : projects).map((p) => {
    const pr = DATA.filter((r) => r.project === p);
    const last = pr.map((r) => r.date).sort().pop() || "";
    const pe = sum(pr, (r) => r.production_errors);
    return `<tr><td>${esc(p)}</td><td>${pr.length}</td><td>${sum(pr, (r) => r.review_high)} / ${sum(pr, (r) => r.review_medium)} / ${sum(pr, (r) => r.review_low)}</td><td>${sum(pr, (r) => r.readback_failures)}</td><td>${sum(pr, (r) => r.manual_findings)}</td><td>${sum(pr, (r) => r.questions)} / ${sum(pr, (r) => r.plan_changes)}</td><td${pe ? ' class="prod"' : ""}>${pe}</td><td>${esc(budget(pr, "duration_hours", 1))}</td><td>${esc(budget(pr, "tokens"))}</td><td>${esc(budget(pr, "cost_usd", 2))}</td><td class="text">${esc(last)}</td></tr>`;
  }).join("");
  document.getElementById("projects").innerHTML =
    `<thead><tr><th>Project</th><th>Activities</th><th>Review (H / M / L)</th><th>Read-back failures</th><th>Manual test findings</th><th>Questions / plan changes</th><th>Production errors</th><th>Hours</th><th>Tokens</th><th>Cost (USD)</th><th class="text">Last activity</th></tr></thead><tbody>${pRows}</tbody>`;

  const aRows = [...rows].sort((a, b) => b.date.localeCompare(a.date)).map((r) =>
    `<tr><td>${esc(r.project)}</td><td class="text">${esc(r.activity)} ${esc(r.name)}</td><td class="text">${esc(r.date)}</td><td>${r.review_high} / ${r.review_medium} / ${r.review_low}</td><td>${r.readback_failures}</td><td>${r.manual_findings}</td><td>${r.questions} / ${r.plan_changes}</td><td${r.production_errors ? ' class="prod"' : ""}>${r.production_errors}</td><td>${cell(r.duration_hours, 1)}</td><td>${cell(r.tokens)}</td><td>${cell(r.cost_usd, 2)}</td><td class="notes">${esc(r.notes)}</td></tr>`).join("");
  document.getElementById("activities").innerHTML =
    `<thead><tr><th>Project</th><th class="text">Activity</th><th class="text">Date</th><th>Review (H / M / L)</th><th>Read-back</th><th>Manual</th><th>Questions / plan changes</th><th>Production</th><th>Hours</th><th>Tokens</th><th>Cost (USD)</th><th class="text">Notes</th></tr></thead><tbody>${aRows || '<tr><td class="text" colspan="12">No activities yet.</td></tr>'}</tbody>`;
}
select.addEventListener("change", render);
document.getElementById("print").addEventListener("click", () => window.print());
render();
</script>
</body>
</html>
"""

if __name__ == "__main__":
    sys.exit(main())
