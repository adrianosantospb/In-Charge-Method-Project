#!/usr/bin/env python3
"""Builds metrics/dashboard.html from metrics/<project>.csv.

The metrics belong to the team. Each project the team works on, the team repository
included, has one file in metrics/, with one row per finished activity. The documentation
maintainer adds the row after the user approves it (see the activity-metrics skill), then
runs:

    bin/metrics                    # rebuild the dashboard
    bin/metrics --check            # only validate the CSV files
    bin/metrics --new <project>    # start metrics/<project>.csv with its header
    bin/metrics --budget --since <time> --until <time> [--cwd <path>]...
                                   # hours, tokens and cost of an activity, from the
                                   # Codex session files in ~/.codex/sessions

The dashboard is one static HTML file with no external scripts. Open it in a browser.
"""

import csv
import datetime as dt
import html
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "metrics" / "dashboard.html"

COLUMNS = {
    "activity": str,
    "date": str,
    "name": str,
    "review_high": int,
    "review_medium": int,
    "review_low": int,
    "readback_failures": int,
    "manual_findings": int,
    "questions": int,
    "plan_changes": int,
    "production_errors": int,
    "duration_hours": "optional_float",
    "tokens": "optional_int",
    "cost_usd": "optional_float",
    "notes": str,
}


def load() -> tuple[list[str], list[dict], list[str]]:
    projects, rows, errors = [], [], []
    for path in sorted((ROOT / "metrics").glob("*.csv")):
        project = path.stem
        projects.append(project)
        with path.open(newline="") as handle:
            reader = csv.DictReader(line for line in handle if not line.startswith("#"))
            missing = set(COLUMNS) - set(reader.fieldnames or [])
            if missing:
                errors.append(f"{path.relative_to(ROOT)}: missing columns {sorted(missing)}")
                continue
            for number, raw in enumerate(reader, start=2):
                row = {"project": project}
                for column, kind in COLUMNS.items():
                    value = (raw.get(column) or "").strip()
                    if kind in ("optional_int", "optional_float"):
                        # Budget columns may stay empty when the number is unknown.
                        try:
                            row[column] = None if value == "" else (int(value) if kind == "optional_int" else float(value))
                        except ValueError:
                            errors.append(f"{path.relative_to(ROOT)} line {number}: {column} must be a number or empty")
                            row[column] = None
                    elif kind is int:
                        if not value.isdigit():
                            errors.append(f"{path.relative_to(ROOT)} line {number}: {column} must be a whole number")
                            value = "0"
                        row[column] = int(value)
                    else:
                        row[column] = value
                try:
                    dt.date.fromisoformat(row["date"])
                except ValueError:
                    errors.append(f"{path.relative_to(ROOT)} line {number}: date must be YYYY-MM-DD")
                rows.append(row)
    return projects, rows, errors


HEADER = """# One row per finished activity of this project. Written by docs_maintainer after the
# user approves it; see the activity-metrics skill. Review findings: high, medium and low,
# without notes of information only. Budget columns (duration_hours, tokens, cost_usd)
# stay empty when the number is unknown.
""" + ",".join(COLUMNS) + "\n"


PRICES = ROOT / "metrics" / "prices.json"
USAGE_BUDGET = "usage: bin/metrics --budget --since <time> --until <time> [--cwd <path>]... [--sessions <dir>]..."
TOKEN_KEYS = ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens")


def parse_time(text: str) -> dt.datetime:
    """ISO 8601 time; without a time zone it is the machine's local time."""
    value = dt.datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    if value.tzinfo is None:
        value = value.astimezone()
    return value.astimezone(dt.timezone.utc)


def option_values(name: str) -> list[str] | None:
    """Values of a repeatable option; None when the option is given without a value."""
    values = []
    for i, arg in enumerate(sys.argv):
        if arg == name:
            if i + 1 >= len(sys.argv) or sys.argv[i + 1].startswith("--"):
                return None
            values.append(sys.argv[i + 1])
    return values


def printable(value: object) -> str:
    """A string from a session file, safe to print: no control or escape characters."""
    if not isinstance(value, str):
        return "?"
    return "".join(c if c.isprintable() else "?" for c in value)[:200]


def same_or_inside(folder: str, roots: list[str]) -> bool:
    candidates = {folder}
    try:
        candidates.add(str(Path(folder).resolve()))
    except (OSError, ValueError):
        pass
    return any(c == r or c.startswith(r.rstrip("/") + "/") for c in candidates for r in roots)


def session_usage(path: Path, since: dt.datetime, until: dt.datetime) -> dict | None:
    """Tokens of one Codex session file inside [since, until], by model.

    Only session_meta, turn_context and token_count lines are parsed; the other lines,
    which hold the conversation, are skipped before they are parsed. Each token_count
    event carries the running total of the session, so the usage in the interval is the
    growth of that total between events inside the interval.

    A forked session starts with a copy of its parent's history, with the parent's
    timestamps. Events dated before the session's own start (its first session_meta)
    only set the baseline and are never counted, so the parent is not counted twice.
    """
    meta = {"id": path.stem, "cwd": "", "forked": False}
    started = None
    model = "unknown"
    previous: dict[str, int] = {}
    by_model: dict[str, dict[str, int]] = {}
    seen = False
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if '"session_meta"' not in line and '"turn_context"' not in line and '"token_count"' not in line:
                continue
            try:
                entry = json.loads(line)
            except (json.JSONDecodeError, RecursionError):
                continue
            if not isinstance(entry, dict) or not isinstance(entry.get("payload"), dict):
                continue
            payload, kind = entry["payload"], entry.get("type")
            try:
                when = parse_time(entry["timestamp"]) if isinstance(entry.get("timestamp"), str) else None
            except ValueError:
                when = None
            if kind == "session_meta":
                if started is None:  # later session_meta lines are copies from a parent
                    started = when
                    if isinstance(payload.get("id"), str):
                        meta["id"] = payload["id"]
                    if isinstance(payload.get("cwd"), str):
                        meta["cwd"] = payload["cwd"]
                    meta["forked"] = bool(payload.get("forked_from_id"))
                continue
            if kind == "turn_context":
                if isinstance(payload.get("model"), str) and payload["model"]:
                    model = payload["model"]
                continue
            if kind != "event_msg" or payload.get("type") != "token_count" or when is None:
                continue
            info = payload.get("info")
            total = info.get("total_token_usage") if isinstance(info, dict) else None
            if not isinstance(total, dict):
                continue
            current = {k: total[k] for k in TOKEN_KEYS if isinstance(total.get(k), int) and not isinstance(total.get(k), bool)}
            counts = since <= when <= until and (started is None or when >= started)
            if counts:
                seen = True
                usage = by_model.setdefault(model, {})
                for key, value in current.items():
                    before = previous.get(key, 0)
                    # A running total that goes down was reset: all of the new value is growth.
                    usage[key] = usage.get(key, 0) + (value - before if value >= before else value)
            previous = current
    if not seen:
        return None
    return {**meta, "by_model": by_model}


def load_prices() -> tuple[dict, list[str]]:
    """Valid prices by model, and problems found in metrics/prices.json."""
    if not PRICES.exists():
        return {}, []
    try:
        data = json.loads(PRICES.read_text())
    except (json.JSONDecodeError, OSError) as error:
        return {}, [f"{PRICES.relative_to(ROOT)} is not valid JSON ({type(error).__name__})"]
    if not isinstance(data, dict):
        return {}, [f"{PRICES.relative_to(ROOT)} must be a JSON object"]
    prices, problems = {}, []

    def number(value: object) -> bool:
        return isinstance(value, (int, float)) and not isinstance(value, bool) and value == value and 0 <= value < float("inf")

    for name, price in data.items():
        if name.startswith("_"):
            continue
        if (
            isinstance(price, dict)
            and number(price.get("input"))
            and number(price.get("output"))
            and ("cached_input" not in price or number(price["cached_input"]))
        ):
            prices[name] = price
        else:
            problems.append(f"{PRICES.relative_to(ROOT)}: price of {printable(name)} needs non-negative numbers for input and output (and cached_input, if given)")
    return prices, problems


def default_session_folders() -> list[Path]:
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
    return [folder for folder in (home / "sessions", home / "archived_sessions") if folder.is_dir()] or [home / "sessions"]


def budget() -> int:
    since_text, until_text = option_values("--since"), option_values("--until")
    folder_args, cwd_args = option_values("--sessions"), option_values("--cwd")
    if None in (since_text, until_text, folder_args, cwd_args) or len(since_text) != 1 or len(until_text) != 1:
        print(USAGE_BUDGET, file=sys.stderr)
        return 2
    try:
        since, until = parse_time(since_text[0]), parse_time(until_text[0])
    except ValueError:
        print("invalid time: use ISO 8601, for example 2026-11-09T14:30-03:00 or 2026-11-09T17:30Z", file=sys.stderr)
        return 2
    if until <= since:
        print("--until must be after --since", file=sys.stderr)
        return 2
    folders = [Path(p).expanduser() for p in folder_args] or default_session_folders()
    cwds = []
    for p in cwd_args:
        raw = str(Path(p).expanduser())
        cwds += [raw, str(Path(raw).resolve())]

    sessions = []
    scanned = recent = unreadable = 0
    other_folders: dict[str, int] = {}
    for folder in folders:
        if not folder.is_dir():
            print(f"{folder}: not found", file=sys.stderr)
            return 1
        for path in sorted(folder.rglob("*.jsonl")):
            try:
                if path.is_symlink() or not path.is_file():
                    continue
                scanned += 1
                if dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc) < since:
                    continue
                recent += 1
                usage = session_usage(path, since, until)
            except (OSError, ValueError, TypeError, AttributeError, RecursionError):
                unreadable += 1
                continue
            if usage is None:
                continue
            if cwds and not same_or_inside(usage["cwd"], cwds):
                key = printable(usage["cwd"]) or "(no folder recorded)"
                other_folders[key] = other_folders.get(key, 0) + 1
                continue
            sessions.append(usage)

    prices, problems = load_prices()
    tokens = 0
    cost = 0.0
    missing: set[str] = set()
    zone = "" if any(t.strip().endswith(("Z", "z")) or "+" in t[10:] or "-" in t[10:] for t in since_text + until_text) else ", local time zone assumed"
    print(f"Interval: {since.isoformat()} to {until.isoformat()} (UTC{zone})")
    print(f"Session files: {scanned} in {', '.join(str(f) for f in folders)}; {recent} changed since the start of the interval")
    if unreadable:
        print(f"Files that could not be read: {unreadable}")
    print(f"Sessions with token events in the interval: {len(sessions)}")
    for s in sessions:
        session_tokens = sum(u.get("total_tokens", 0) for u in s["by_model"].values())
        tokens += session_tokens
        models = ", ".join(printable(m) for m in sorted(s["by_model"]))
        fork = "  (fork)" if s["forked"] else ""
        print(f"  {printable(s['id'])}  {session_tokens:>12,} tokens  {models}  {printable(s['cwd'])}{fork}")
        for model, u in s["by_model"].items():
            price = prices.get(model)
            if not price:
                missing.add(printable(model))
                continue
            cached = u.get("cached_input_tokens", 0)
            fresh = max(0, u.get("input_tokens", 0) - cached)
            cost += (
                fresh * price["input"]
                + cached * price.get("cached_input", price["input"])
                + u.get("output_tokens", 0) * price["output"]
            ) / 1_000_000
    if other_folders:
        print("Left out by --cwd:")
        for name, count in sorted(other_folders.items()):
            print(f"  {count} session(s) in {name}")
    for problem in problems:
        print(problem)
    hours = (until - since).total_seconds() / 3600
    cost_text = "" if missing or not sessions else f"{cost:.2f}"
    if missing:
        print(f"No valid price in {PRICES.relative_to(ROOT)} for: {', '.join(sorted(missing))}. cost_usd stays empty.")
    print()
    print("duration_hours,tokens,cost_usd")
    print(f"{hours:.1f},{tokens if sessions else ''},{cost_text}")
    if cost_text:
        print("Cost at API prices; on a subscription plan it is not the amount paid.")
    return 0


def main() -> int:
    if "--budget" in sys.argv:
        return budget()
    if "--new" in sys.argv:
        name = sys.argv[sys.argv.index("--new") + 1] if len(sys.argv) > sys.argv.index("--new") + 1 else ""
        if not name or not all(c.isalnum() or c in "-_" for c in name):
            print("usage: bin/metrics --new <project>", file=sys.stderr)
            return 2
        path = ROOT / "metrics" / f"{name}.csv"
        if path.exists():
            print(f"{path.relative_to(ROOT)} already exists", file=sys.stderr)
            return 1
        path.parent.mkdir(exist_ok=True)
        path.write_text(HEADER)
        print(f"{path.relative_to(ROOT)}: created")
        return 0
    projects, rows, errors = load()
    for error in errors:
        print(error, file=sys.stderr)
    if errors:
        return 1
    if "--check" in sys.argv:
        print(f"{len(rows)} activities in {len(projects)} projects: OK")
        return 0
    page = TEMPLATE.replace(
        "__DATA__", json.dumps(rows, ensure_ascii=False).replace("</", "<\\/")
    ).replace("__PROJECTS__", json.dumps(projects, ensure_ascii=False).replace("</", "<\\/")).replace("__GENERATED__", html.escape(dt.date.today().isoformat()))
    OUT.parent.mkdir(exist_ok=True)
    OUT.write_text(page)
    print(f"{OUT.relative_to(ROOT)}: {len(rows)} activities")
    return 0


