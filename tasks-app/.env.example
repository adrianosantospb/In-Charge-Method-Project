# Copy to .env and fill in every value. Never commit .env.
# Empty values stop "docker compose up" on purpose.
# Generate each value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
TASKS_JWT_SECRET=
# Keep true behind HTTPS. Set to false only to try the production stack on http://localhost.
TASKS_COOKIE_SECURE=true
